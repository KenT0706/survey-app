APP_NAME="Survey App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.onrender.com

# Public frontend URL — QR codes point here, and CORS (config/cors.php) allows only this origin
FRONTEND_URL=https://your-app.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Render's free tier has no managed MySQL — this app is built against PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Only needed if you later add email notifications (e.g. "notify me when someone responds").
# Render's free tier blocks outbound SMTP (port 25/587), so use Resend's HTTPS API like HRTC does.
# MAIL_MAILER=resend
# RESEND_KEY=
